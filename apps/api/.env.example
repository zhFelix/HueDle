# HueDle API 环境变量模板。复制为 apps/api/.env 后填写（.env 已被 .gitignore 忽略）。
# 说明文档：docs/DESIGN.md 第 10 节；数据库迁移见 `pnpm -C apps/api migrate`。

# Supabase 托管 Postgres 连接串。Supabase 只当数据库用：
# 不使用 Supabase Auth / RLS / supabase-js，也不从浏览器直连。
# 取 Dashboard → Project Settings → Database → Connection string（URI）。
# 直连端口 5432：支持连接级 options，测试靠它把表限制在独立 schema huedle_test。
# 若用连接池（pgbouncer，端口 6543），`pnpm -C apps/api test` 会在建表前报错拒绝运行。
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# CORS 白名单，逗号分隔；留空使用默认 http://localhost:5173,http://127.0.0.1:4173
HUEDLE_ORIGIN=

# 设为 1 时才信任 X-Forwarded-For / X-Real-IP 作为限流分桶 IP（仅当部署在反向代理之后）
HUEDLE_TRUST_PROXY=

# 监听端口，默认 3001
PORT=
